{
  "name": "sensor-config-tools",
  "version": "0.0.1",
  "description": "Longan Aggregate Tools - IPC, Sensor Management & Utilities",
  "repository": {
    "type": "git",
    "url": "https://github.com/CherishMvp/longan-ipc-config.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron.dev",
    "build": "vue-tsc --noEmit && vite build",
    "build:electron": "vite build --mode electron.prod && electron-builder",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "release": "node scripts/release.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-builder",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.sensor.config-tools",
    "productName": "Longan Tools",
    "executableName": "sensor-config-tools",
    "copyright": "Copyright © 2025",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map",
      "!**/*.d.ts",
      "!src/**/*",
      "!docs/**/*",
      "!generate_icon.py",
      "!*.md",
      "!scripts/**/*"
    ],
    "win": {
      "icon": "electron/build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${name}-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "icon": "electron/build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${name}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "electron/build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "bbttcherish@outlook.com",
      "category": "Utility",
      "artifactName": "${name}-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Longan工具箱",
      "deleteAppDataOnUninstall": true,
      "allowElevation": true,
      "unicode": true
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.7.8",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "fs-extra": "^11.3.3",
    "lucide-vue-next": "^0.460.0",
    "pinia": "^2.2.6",
    "radix-vue": "^1.9.0",
    "reka-ui": "^2.7.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^18.18.2",
    "@types/uuid": "^11.0.0",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "png2icons": "^2.0.1",
    "typescript": "^5.7.2",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.0.13"
  }
}
